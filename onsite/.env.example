DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string

# Text messages (login codes, shift offers). Leave all blank in dev and codes print to the server log / login screen.
# Which provider to use: clicksend or twilio. Blank = whichever has credentials below (ClickSend first).
SMS_PROVIDER=
# ClickSend (Australian gateway) — username and API key from the ClickSend dashboard (API Credentials).
CLICKSEND_USERNAME=
CLICKSEND_API_KEY=
# Optional sender (a dedicated number or registered alpha tag). Blank = ClickSend's shared number.
CLICKSEND_FROM=
# Twilio, if used instead
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Show OTP code on the login screen. Anyone can then sign in as any number — dev and demos only.
# Ignored on a Vercel production deployment unless DEMO_SITE=1 is also set there.
DEV_SHOW_OTP=1
# 1 = this public deployment is a demo, not real production: allows DEV_SHOW_OTP / DEMO_CONSOLE on Vercel
# production, and the login screen and /privacy say it's a demo. Remove when going live with texts.
DEMO_SITE=
# Secret for /api/cron/expand (matching batch expansion). Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=change-me
# Public base URL used in invite links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Closed beta: 1 = only numbers on the guest list (npm run beta:invite) or with an account can get a login code.
BETA_INVITE_ONLY=
# Shown on /privacy and /terms as the contact. Both must be set, or neither page shows a contact line.
PRIVACY_CONTACT_EMAIL=
BUSINESS_NAME=

# What the boss pays (README → Billing). Every one of these is optional; the defaults are the product's prices.
# Invoices are paid only through QPay (the QPAY_ settings below); a paid invoice marks itself paid.
# $2 the first time OnSite introduces a boss to a worker, charged when that worker's hours are first approved.
MATCH_FEE_CENTS=200
# That is the whole price list. There is no subscription and no trial: SUBSCRIPTION_CENTS and TRIAL_DAYS are
# read by nothing now and can come out of any deployment that still sets them.
# How long a boss has to pay an invoice, counted from the day it is issued. Separate from the 14-day billing
# fortnight (FORTNIGHT_DAYS, lib/subscription.ts) and deliberately shorter than it.
PAYMENT_TERMS_DAYS=7
# 1 = invoices say they include GST, at 1/11 of the total. GST is inside the price, never added on top.
GST_REGISTERED=
# The tögrög amount is worked out at a live rate when the boss taps Pay (lib/fxRate.ts, README → Billing): the Bank of
# Mongolia's official daily AUD rate, then ExchangeRate-API's open endpoint if that fails, cached 6 h in fx_rates.
# Rates outside ₮1,000–₮5,000 per A$1 are treated as a broken source. Nothing to set for any of that.
# AUD_MNT_RATE: tögrög per 1 AUSTRALIAN dollar, used only if both sources fail. NOT per US dollar: on 17 Sept 2026
# the Bank of Mongolia had A$1 = ₮2,559 and US$1 = ₮3,596 — putting the US figure here overcharges by ~40%.
AUD_MNT_RATE=
# 1 = use AUD_MNT_RATE ahead of the live sources, and fetch nothing. For when a person has decided the rate.
AUD_MNT_RATE_OVERRIDE=
# The invoice's "From" block: BUSINESS_NAME above, plus this. Without a business name there is no From block.
BUSINESS_ABN=

# QPay merchant API v2 (payments in MNT) — how bosses pay their invoices. Check with: npm run qpay:ping
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=
QPAY_PASSWORD=
QPAY_INVOICE_CODE=
# Signs callback URLs so only QPay can nudge a payment check. Falls back to SESSION_SECRET if blank.
QPAY_CALLBACK_SECRET=

# NSW White Card register (api.nsw.gov.au → your app → keys). Leave blank and every card is checked by hand.
# Check with: npm run whitecard:ping
WHITE_CARD_API_KEY=
WHITE_CARD_API_SECRET=
# Optional: the ready-made "Basic …" header the portal shows. Used as pasted; without it we derive one from key:secret.
WHITE_CARD_AUTH_HEADER=
# Register calls the whole app may make in a day (default 70). The free tier is 2,500 a month and there is no sandbox;
# over the ceiling a card is saved as "not checked" and re-checked by the cron once the budget is back — never as "not on the register".
WHITECARD_CHECKS_PER_DAY=

# Phone alerts (web push). Generate once with: npx web-push generate-vapid-keys
# Without them, shift offers still go by SMS (when a provider is set) and everything shows in the app.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact address push services can reach you on (mailto: or https:)
VAPID_SUBJECT=
# Login codes: most SMS codes the whole app will actually send in an hour (default 1000; refused requests don't count).
# Australian mobiles only unless ALLOW_INTL_PHONES=1 (testing).
OTP_SENDS_PER_HOUR=
ALLOW_INTL_PHONES=
# Shift-offer texts the whole app may send in an hour (default 500); one boss may use a fifth of it. Each person gets at most 5 a day.
SMS_ALERTS_PER_HOUR=

# Control room at /console: two phones side by side + scenarios. Demo only — ignored on a Vercel production deployment.
DEMO_CONSOLE=1
