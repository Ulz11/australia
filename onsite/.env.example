DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
SESSION_SECRET=change-me-to-a-long-random-string
# Optional: leave blank in dev and codes print to the server log / login screen
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# Show OTP code on the login screen (dev only)
DEV_SHOW_OTP=1
# Secret for /api/cron/expand (matching batch expansion)
CRON_SECRET=change-me
# Public base URL used in invite links
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Control room at /console: two phones side by side + scenarios. Demo only — never 1 in production.
DEMO_CONSOLE=1
